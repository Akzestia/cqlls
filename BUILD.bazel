load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

TEST_DATA = glob(["tests/cql/**"])

rust_library(
    name = "cqlls_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "cqlls",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "cqlls",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [":cqlls_lib"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_test",
    size = "small",
    crate = ":cqlls_lib",
    data = TEST_DATA,
)

rust_test(
    name = "cqlls_test",
    size = "small",
    srcs = ["tests/cqlls.rs"],
    data = TEST_DATA,
    edition = "2024",
    deps = [":cqlls_lib"] + all_crate_deps(normal = True),
)

[
    rust_test(
        name = t,
        srcs = ["tests/%s.rs" % t],
        edition = "2024",
        tags = [
            "external",
            "manual",
            "requires-network",
        ],
        deps = [":cqlls_lib"] + all_crate_deps(normal = True),
    )
    for t in [
        "scylla_no_tls",
        "scylla_tls",
        "scylla_schema_correctness",
    ]
]
